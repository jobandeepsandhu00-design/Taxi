// Taxi Prüfung Österreich – Datenbankschema
// Mehrere Bundesländer werden über `Region` unterstützt (zunächst Wien).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Herkunft einer Frage. Nur OFFICIAL darf als offizielle Prüfungsfrage angezeigt werden
/// und erfordert eine verifizierte Quelle.
enum ContentOrigin {
  OFFICIAL
  PRACTICE
  DEMO
}

enum SourceType {
  LAW
  OFFICIAL_EXAM
  OFFICIAL_DOCUMENT
  TEXTBOOK
  OTHER
}

enum QuizMode {
  LEARN
  PRACTICE
  MISTAKES
  REVIEW
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum ExamStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum FlashcardStatus {
  NEW
  LEARNING
  LEARNED
}

model Region {
  id          String       @id @default(cuid())
  code        String       @unique @db.VarChar(16)
  name        String       @db.VarChar(80)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  users       User[]
  categories  Category[]
  examConfigs ExamConfig[]
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique @db.VarChar(254)
  name              String              @db.VarChar(120)
  passwordHash      String
  role              Role                @default(STUDENT)
  isActive          Boolean             @default(true)
  regionId          String?
  region            Region?             @relation(fields: [regionId], references: [id], onDelete: SetNull)
  targetExamDate    DateTime?           @db.Date
  /// Gastkonto: pro Gerät angelegt, ohne E-Mail/Passwort; kann später in ein echtes Konto umgewandelt werden
  isGuest           Boolean             @default(false)
  examType          ExamType?
  dailyGoalMinutes  Int?
  onboardedAt       DateTime?
  /// Gewählter Avatar (Schlüssel, z. B. "taxi")
  avatar            String?             @db.VarChar(20)
  /// Erfahrungspunkte (Level-System)
  xp                Int                 @default(0)
  achievements      UserAchievement[]
  reviewItems       ReviewItem[]
  lessons           Lesson[]
  readinessSnapshots ReadinessSnapshot[]
  variantFeedback   VariantFeedback[]
  numberProgress    NumberProgress[]
  routeProgress     RouteProgress[]
  helperLang        String?             @db.VarChar(8)
  ortskundeAttempts OrtskundeAttempt[]
  dailyChallenges   DailyChallengeResult[]
  hostedDuels       Duel[]              @relation("DuelHost")
  joinedDuels       Duel[]              @relation("DuelGuest")
  duelAnswers       DuelAnswer[]
  pushSubscriptions PushSubscription[]
  /// Premium: unbegrenzte Coach-Nachrichten
  isPremium         Boolean             @default(false)
  theme             String              @default("weiss") @db.VarChar(16)
  themeMode         String              @default("light") @db.VarChar(8)
  coachMessages     CoachMessage[]
  dailyPlans        DailyPlan[]
  weeklyReports     WeeklyReport[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  lastLoginAt       DateTime?
  answers           UserAnswer[]
  quizAttempts      QuizAttempt[]
  examAttempts      ExamAttempt[]
  flashcards        FlashcardProgress[]
  streak            LearningStreak?
  progress          UserProgress[]
  mistakes          MistakeEntry[]
  bookmarks         Bookmark[]
  dailyActivity     DailyActivity[]
  createdQuestions  Question[]          @relation("QuestionCreatedBy")

  @@index([role])
  @@index([isGuest, lastLoginAt])
}

enum ExamType {
  TAXILENKER
  KONZESSION
}

model Category {
  id               String         @id @default(cuid())
  slug             String         @unique @db.VarChar(80)
  name             String         @db.VarChar(160)
  shortDescription String         @db.VarChar(300)
  introduction     String         @db.Text
  color            String         @default("blue") @db.VarChar(20)
  icon             String         @default("BookOpen") @db.VarChar(40)
  order            Int            @default(0)
  difficulty       Difficulty     @default(MEDIUM)
  isActive         Boolean        @default(true)
  /// Verweis auf den offiziellen Prüfungsstoff (z. B. Verordnung, Paragraph)
  syllabusReference String?       @db.Text
  /// true, wenn der Inhalt dieser Kategorie mit dem aktuellen offiziellen Prüfungsstoff abgeglichen wurde
  syllabusVerified Boolean        @default(false)
  regionId         String?
  region           Region?        @relation(fields: [regionId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  topics           Topic[]
  questions        Question[]
  progress         UserProgress[]

  @@index([regionId, isActive, order])
}

model Topic {
  id          String     @id @default(cuid())
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  slug        String     @db.VarChar(80)
  name        String     @db.VarChar(160)
  description String?    @db.Text
  order       Int        @default(0)
  questions   Question[]

  @@unique([categoryId, slug])
  @@index([categoryId, order])
}

model QuestionSource {
  id         String     @id @default(cuid())
  title      String     @db.VarChar(255)
  type       SourceType @default(LAW)
  reference  String?    @db.VarChar(255)
  url        String?    @db.VarChar(500)
  verified   Boolean    @default(false)
  verifiedAt DateTime?
  note       String?    @db.Text
  createdAt  DateTime   @default(now())
  questions  Question[]
}

model Question {
  id              String              @id @default(cuid())
  text            String              @db.Text
  explanation     String              @db.Text
  categoryId      String
  category        Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  topicId         String?
  topic           Topic?              @relation(fields: [topicId], references: [id], onDelete: SetNull)
  difficulty      Difficulty          @default(MEDIUM)
  multipleCorrect Boolean             @default(false)
  imageUrl        String?             @db.VarChar(500)
  tags            String[]            @default([])
  status          QuestionStatus      @default(DRAFT)
  origin          ContentOrigin       @default(PRACTICE)
  sourceId        String?
  source          QuestionSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  /// Genaue Fundstelle, z. B. "§ 20 Abs. 2 StVO"
  sourceDetail    String?             @db.VarChar(255)
  createdById     String?
  createdBy       User?               @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  options         AnswerOption[]
  userAnswers     UserAnswer[]
  examResponses   ExamResponse[]
  flashcards      FlashcardProgress[]
  reviewItems     ReviewItem[]
  variants        QuestionVariant[]
  mistakes        MistakeEntry[]
  bookmarks       Bookmark[]

  @@index([categoryId, status])
  @@index([status, difficulty])
  @@index([topicId])
  @@index([origin])
}

model AnswerOption {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label       String   @db.VarChar(1)
  text        String   @db.Text
  isCorrect   Boolean  @default(false)
  explanation String?  @db.Text
  order       Int      @default(0)

  @@unique([questionId, label])
  @@index([questionId])
}

model UserAnswer {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionIds String[]
  isCorrect         Boolean
  mode              QuizMode
  quizAttemptId     String?
  quizAttempt       QuizAttempt? @relation(fields: [quizAttemptId], references: [id], onDelete: SetNull)
  timeSpentSec      Int          @default(0)
  createdAt         DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([userId, questionId])
  @@index([quizAttemptId])
}

model QuizAttempt {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode         QuizMode
  categoryId   String?
  title        String        @db.VarChar(200)
  questionIds  String[]
  currentIndex Int           @default(0)
  status       AttemptStatus @default(IN_PROGRESS)
  correctCount Int           @default(0)
  answeredCount Int          @default(0)
  settings     Json?
  startedAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  finishedAt   DateTime?
  answers      UserAnswer[]

  @@index([userId, status])
  @@index([userId, startedAt])
}

model ExamConfig {
  id                String        @id @default(cuid())
  name              String        @db.VarChar(160)
  description       String?       @db.Text
  regionId          String?
  region            Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  durationMinutes   Int
  questionCount     Int
  passPercentage    Int
  /// Optional: { "<categoryId>": anzahl } – feste Anzahl Fragen je Kategorie
  categoryDistribution Json?
  /// Nur Fragen dieser Herkunft verwenden (leer = alle veröffentlichten)
  allowedOrigins    ContentOrigin[] @default([])
  isActive          Boolean       @default(true)
  isDefault         Boolean       @default(false)
  /// true, wenn Dauer/Fragenanzahl/Bestehensgrenze mit der offiziellen Prüfungsordnung abgeglichen wurden
  verified          Boolean       @default(false)
  officialReference String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  attempts          ExamAttempt[]

  @@index([regionId, isActive])
}

model ExamAttempt {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  examConfigId    String
  examConfig      ExamConfig     @relation(fields: [examConfigId], references: [id], onDelete: Restrict)
  status          ExamStatus     @default(IN_PROGRESS)
  durationMinutes Int
  passPercentage  Int
  startedAt       DateTime       @default(now())
  expiresAt       DateTime
  submittedAt     DateTime?
  correctCount    Int?
  totalCount      Int
  scorePercent    Float?
  passed          Boolean?
  currentIndex    Int            @default(0)
  responses       ExamResponse[]

  @@index([userId, status])
  @@index([userId, startedAt])
}

model ExamResponse {
  id                String      @id @default(cuid())
  examAttemptId     String
  examAttempt       ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order             Int
  selectedOptionIds String[]    @default([])
  markedForReview   Boolean     @default(false)
  isCorrect         Boolean?
  answeredAt        DateTime?

  /// Garantiert: keine doppelten Fragen in einer Prüfung
  @@unique([examAttemptId, questionId])
  @@unique([examAttemptId, order])
}

model FlashcardProgress {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  status         FlashcardStatus @default(NEW)
  reviewCount    Int             @default(0)
  difficultCount Int             @default(0)
  lastReviewedAt DateTime?

  @@unique([userId, questionId])
  @@index([userId, status])
}

model LearningStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveDate DateTime? @db.Date
}

model UserProgress {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  answeredCount  Int      @default(0)
  correctCount   Int      @default(0)
  incorrectCount Int      @default(0)
  /// Anzahl unterschiedlicher Fragen, die mindestens einmal richtig beantwortet wurden
  masteredCount  Int      @default(0)
  lastActivityAt DateTime @default(now())

  @@unique([userId, categoryId])
}

model MistakeEntry {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  wrongCount    Int       @default(1)
  correctStreak Int       @default(0)
  resolved      Boolean   @default(false)
  resolvedAt    DateTime?
  lastWrongAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@unique([userId, questionId])
  @@index([userId, resolved])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
}

/// Tägliche Lernaktivität (Lernzeit, beantwortete Fragen) für Statistiken
model DailyActivity {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime @db.Date
  secondsStudied    Int      @default(0)
  questionsAnswered Int      @default(0)
  correctAnswers    Int      @default(0)

  @@unique([userId, date])
}

model MediaFile {
  id        String   @id @default(cuid())
  filename  String   @db.VarChar(255)
  mimeType  String   @db.VarChar(100)
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model AppSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt
}

/// Freigeschaltete Abzeichen und Level-Aufstiege (key z. B. "erste-100" oder "level-2")
model UserAchievement {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String    @db.VarChar(60)
  unlockedAt DateTime  @default(now())
  /// Wann die Freischalt-Animation gezeigt wurde
  seenAt     DateTime?

  @@unique([userId, key])
  @@index([userId, seenAt])
}

/// Leitner-Karteikasten für verteilte Wiederholung (Fach 1–5)
model ReviewItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  box            Int      @default(1)
  dueDate        DateTime @db.Date
  lastReviewedAt DateTime @default(now())
  timesCorrect   Int      @default(0)
  timesWrong     Int      @default(0)

  @@unique([userId, questionId])
  @@index([userId, dueDate])
}

/// „Wo liegt …?“-Antworten auf der Ortskunde-Karte (für die Bezirks-Heatmap)
model OrtskundeAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @db.VarChar(12)
  placeKey  String   @db.VarChar(40)
  district  Int
  correct   Boolean
  distanceM Int?
  createdAt DateTime @default(now())

  @@index([userId, district])
}

/// Tägliche Challenge: 5 Fragen pro Tag, für alle gleich
model DailyChallengeResult {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day         DateTime @db.Date
  correct     Int
  total       Int
  durationSec Int
  createdAt   DateTime @default(now())

  @@unique([userId, day])
  @@index([day, correct])
}

enum DuelStatus {
  WAITING
  ACTIVE
  FINISHED
  CANCELLED
}

/// 1-gegen-1-Duell (Echtzeit über kurzes Polling)
model Duel {
  id          String       @id @default(cuid())
  code        String       @unique @db.VarChar(8)
  hostId      String
  host        User         @relation("DuelHost", fields: [hostId], references: [id], onDelete: Cascade)
  guestId     String?
  guest       User?        @relation("DuelGuest", fields: [guestId], references: [id], onDelete: Cascade)
  questionIds String[]
  status      DuelStatus   @default(WAITING)
  createdAt   DateTime     @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  answers     DuelAnswer[]

  @@index([hostId, status])
  @@index([guestId, status])
}

model DuelAnswer {
  id        String   @id @default(cuid())
  duelId    String
  duel      Duel     @relation(fields: [duelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  index     Int
  isCorrect Boolean
  timeMs    Int
  createdAt DateTime @default(now())

  @@unique([duelId, userId, index])
}

/// Web-Push-Abos für Serien-Erinnerungen
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Coach-Verlauf (Chat, „Warum?“, Einfache Sprache, mündliche Prüfung) – auch Basis für Tageslimit und Feedback
model CoachMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @db.VarChar(16)
  role      String   @db.VarChar(12)
  content   String   @db.Text
  citations Json?
  /// 1 = 👍, -1 = 👎
  feedback  Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
}

/// Frage in Einfacher Sprache (B1), einmal erzeugt und für alle zwischengespeichert

/// Tagesplan des Coaches (per Cron um 06:00 Wien oder beim ersten Öffnen erzeugt)
model DailyPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  items     Json
  createdAt DateTime @default(now())

  @@unique([userId, day])
}

/// Wochenbericht (sonntags): Stärken, Schwächen, Prognose, 3 Schritte
model WeeklyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart DateTime @db.Date
  data      Json
  createdAt DateTime @default(now())

  @@unique([userId, weekStart])
}

/// Mini-Lektion: 5 Fragen, ca. 3 Minuten (läuft als QuizAttempt)
model Lesson {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// mix = Leitner-Mix, review = fällige Wiederholung, category = feste Kategorie-Lektion
  kind          String    @db.VarChar(12)
  categoryId    String?
  lessonIndex   Int?
  questionIds   String[]
  quizAttemptId String?   @unique
  score         Int?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, categoryId, lessonIndex])
}

/// Prüfungsreife je Tag (Cache + Trendlinie)
model ReadinessSnapshot {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  score     Int
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([userId, day])
}

/// KI-Varianten einer Frage (einmal erzeugt, danach aus der DB): simple, glossary, translation, why, why_wrong_A …
model QuestionVariant {
  id         String            @id @default(cuid())
  questionId String
  question   Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kind       String            @db.VarChar(32)
  lang       String            @default("de") @db.VarChar(8)
  content    Json
  model      String            @db.VarChar(80)
  verified   Boolean           @default(false)
  createdAt  DateTime          @default(now())
  feedback   VariantFeedback[]

  @@unique([questionId, kind, lang])
  @@index([verified, kind, lang])
}

/// 👍/👎 zu einer KI-Variante; 👎 landet in der Prüf-Warteschlange
model VariantFeedback {
  id        String          @id @default(cuid())
  variantId String
  variant   QuestionVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  createdAt DateTime        @default(now())

  @@unique([variantId, userId])
  @@index([rating])
}

/// Zahlen-Trainer: typische Prüfungszahlen (Promille, Fristen, Abstände …); Aussage mit Platzhalter {x}
model NumberFact {
  id               String           @id @default(cuid())
  examMode         String           @default("TAXI") @db.VarChar(20)
  category         String           @db.VarChar(80)
  statement        String           @db.Text
  value            String           @db.VarChar(40)
  unit             String           @default("") @db.VarChar(20)
  distractors      String[]
  legalReference   String?          @db.VarChar(255)
  verified         Boolean          @default(false)
  sourceQuestionId String?          @db.VarChar(64)
  createdAt        DateTime         @default(now())
  progress         NumberProgress[]

  @@index([verified, category])
}

/// Leitner-Fortschritt je Zahlen-Fakt
model NumberProgress {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  factId       String
  fact         NumberFact @relation(fields: [factId], references: [id], onDelete: Cascade)
  box          Int        @default(1)
  dueDate      DateTime   @db.Date
  lastSeenAt   DateTime   @default(now())
  timesCorrect Int        @default(0)
  timesWrong   Int        @default(0)

  @@unique([userId, factId])
  @@index([userId, dueDate])
}

/// Ortskunde-Route als geordnete Straßenliste (für Etappen + Lückentext)
model Route {
  id        String          @id @default(cuid())
  slug      String          @unique @db.VarChar(80)
  fromName  String          @db.VarChar(120)
  toName    String          @db.VarChar(120)
  streets   String[]
  /// je Straße ein Linienzug [[lng, lat], …]
  path      Json
  examMode  String          @default("TAXI") @db.VarChar(20)
  verified  Boolean         @default(false)
  createdAt DateTime        @default(now())
  progress  RouteProgress[]
}

/// Fortschritt je Route und Etappe (stageIndex = Anzahl Etappen → ganze Route)
model RouteProgress {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId         String
  route           Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stageIndex      Int
  level           Int      @default(0)
  mastered        Boolean  @default(false)
  fullCorrectDays String[] @default([])
  updatedAt       DateTime @updatedAt

  @@unique([userId, routeId, stageIndex])
}
